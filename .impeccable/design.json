      "html": "<label class=\"ds-search-label\">Search tours<div class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 4 4\"/></svg><input placeholder=\"Look for the next tour\" /></div></label>",
      "css": ".ds-search-label{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;font-size:14px;color:var(--mantine-color-text,#000)}.ds-search{display:flex;align-items:center;gap:10px;border:1px solid purple;border-radius:var(--mantine-radius-xl,32px);padding:0 16px;background:var(--mantine-color-body,#fff);color:var(--mantine-color-dimmed,#868e96)}.ds-search input{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;height:48px;width:100%;min-width:0;border:0;background:transparent;font-size:18px;color:var(--mantine-color-text,#000);outline:none}.ds-search:hover{border-color:var(--mantine-color-grape-6,#be4bdb)}.ds-search:focus-within{outline:2px solid var(--mantine-color-blue-6,#228be6);outline-offset:2px;}"
    },
