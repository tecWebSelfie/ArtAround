{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "dockerComposeFile": ["../docker-compose.yml", "./docker-compose.devcontainer.yaml"],
  "workspaceFolder": "/workspace",
  "service": "app",
  "postCreateCommand": "sudo chown -R node:node /workspace/node_modules && npm install",
  "forwardPorts": [3000, 27017, 4000], // Forwarding ports for the application and MongoDB ,
  "remoteUser": "node",
  "containerUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "hverlin.mise-vscode"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "node",
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },

    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true,
      "moby": false
    },

    "ghcr.io/devcontainers/features/github-cli:1.1.2": {},
    "ghcr.io/actcoding/devcontainer-features/git-delta:1": {},
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  }
}
