# Root user of the `mongodb` service in docker-compose.yml. The official image
# enables authentication only with these two names, and only when it creates an
# EMPTY data volume: on an existing `mongo-data` volume they are ignored (recreate
# it, or add the user with mongosh). The app's DATABASE_URL in .env must match:
#   DATABASE_URL=mongodb://USER:PASSWORD@mongodb:27017/artaround?authSource=admin
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
