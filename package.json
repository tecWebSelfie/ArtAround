{
  "name": "",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:navmesh-schema": "typescript-json-schema tsconfig.json NavMesh --include src/lib/schemas/navmesh.ts --required --skipLibCheck --refs false --out src/lib/schemas/navmesh.schema.json",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "postinstall": "node scripts/copy-vad-assets.mjs && node scripts/copy-zxing-assets.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:visual": "cross-env NODE_OPTIONS=--no-deprecation VISUAL_REGRESSION=1 vitest run --config ./vitest.config.mts --project storybook",
    "test:visual:update": "cross-env NODE_OPTIONS=--no-deprecation VISUAL_REGRESSION=1 vitest run --config ./vitest.config.mts --project storybook --update",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "react-doctor": "npx react-doctor@latest",
    "knip": "knip",
    "models:standee": "node scripts/generate-default-standee.mjs",
    "search:reindex": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/reindex-search.ts",
    "agent:dev": "docker compose up -d && lk agent dev --dev ./my-agent/src/main.ts",
    "agent:console": "docker compose up -d && lk agent --dev console ./my-agent/src/main.ts",
    "agent:create": "lk agent create ./my-agent --secrets-file ./my-agent/.env.local",
    "agent:deploy": "lk agent deploy ./my-agent --secrets-file ./my-agent/.env.local",
    "intl:dev": "i18next-cli extract --sync-all --trust-derived --with-types -w",
    "openapi-ts": "openapi-ts"
  },
