{
  "name": "",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "extract": "formatjs extract",
    "compile": "formatjs compile",
    "react-doctor": "npx react-doctor@latest",
    "knip": "knip"
  },
  "dependencies": {
    "@adobe/leonardo-contrast-colors": "^1.1.0",
    "@dnd-kit/dom": "^0.5.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@mantine/carousel": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/nprogress": "^9.5.1",
    "@mantine/tiptap": "^9.5.1",
    "@payloadcms/db-mongodb": "^3.88.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-form-builder": "^3.88.0",
    "@payloadcms/plugin-import-export": "^3.88.0",
    "@payloadcms/plugin-mcp": "^3.88.0",
    "@payloadcms/plugin-nested-docs": "^3.88.0",
    "@payloadcms/plugin-redirects": "^3.88.0",
    "@payloadcms/plugin-stripe": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/ui": "3.86.0",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.70.0",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/three": "^0.185.4",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "16.4.7",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.22.3",
    "navcat": "^0.4.1",
    "next": "16.2.6",
    "payload": "^3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-intl": "^10.1.22",
    "sharp": "0.34.2",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@formatjs/cli": "^6.16.19",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "^10.5.3",
    "husky": "^9.1.7",
    "jsdom": "28.0.0",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "loki": "^0.35.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.4.2",
    "storybook": "^10.5.3",
    "tsx": "4.22.4",
    "typescript": "^5.7.3",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "loki": {
    "diffingEngine": "gm",
    "configurations": {
      "chrome.laptop": {
        "target": "chrome.docker",
        "width": 1366,
        "height": 768,
        "deviceScaleFactor": 1,
        "mobile": false
      },
      "chrome.iphone7": {
        "target": "chrome.docker",
        "preset": "iPhone 7"
      }
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
