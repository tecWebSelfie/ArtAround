{
  "mcpServers": {
    "payload-mcp": {
      "type": "http",
      "url": "http://127.0.0.1:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${PAYLOAD_MCP_KEY}"
      }
    },
    "Sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/tecweb/artaround"
    },
    "livekit-docs-mcp": {
      "type": "http",
      "url": "https://docs.livekit.io/mcp"
    },
    "mantine-ui": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@mantine/mcp-server"],
      "env": {}
    },
    "nextjs": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "next-devtools-mcp@latest"],
      "env": {}
    },
    "shadcn": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "shadcn@latest", "mcp"],
      "env": {}
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "typesense": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@typesensekit/mcp"],
      "env": {
        "TYPESENSE_URL": "https://${TYPESENSE_HOST}",
        "TYPESENSE_API_KEY": "${TYPESENSE_API_KEY}",
        "TYPESENSEKIT_READ_ONLY": "false"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"],
      "env": {}
    }
  }
}
