DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Voice agent (server-only, never NEXT_PUBLIC_*). Local dev: ws://localhost:7880 + compose dev key/secret. Prod: wss://xxx.livekit.cloud + Cloud keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=my-agent
