# Added by Payload
PAYLOAD_SECRET=
# The compose MongoDB (`pnpm services:start`, no authentication):
# mongodb://127.0.0.1:27017/artaround from the host,
# mongodb://mongodb:27017/artaround from the compose `app` container.
DATABASE_URL=
# Optional: the folder uploads are saved in (pictures, maps, models, audio).
# Unset, they go in the working directory. The standalone deploy needs
# `../uploads`, a writable folder next to the standalone (docs/standalone-deploy.md).
UPLOADS_DIR=

NEXT_PUBLIC_PAYLOAD_URL=
# Optional: where the server calls its own routes when NEXT_PUBLIC_PAYLOAD_URL
# isn't reachable from inside (cloud preview, docs/cloud-preview.md).
PAYLOAD_INTERNAL_URL=
PAYLOAD_MCP_KEY=

#API MOCKING
NEXT_PUBLIC_API_MOCKING=

#LiveKit (group tours, docs/group-tours.md). Local: ws://localhost:7880 with devkey/secret
# from my-agent/compose.livekit.yaml; production: a LiveKit Cloud wss:// URL and keys.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

#Typesense (search, docs/search.md). Local: the compose `typesense` node of
# `pnpm services:start` (development key `xyz`, loopback only); production: the
# Typesense Cloud host, its admin key, port 443 and https.
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=artaround

#Mint (3D models generation and hosting)
MINT_API_KEY=

#Stripe (SANDBOX ONLY — use test keys `sk_test_…`)
# Secret API key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret for `POST /api/stripe/webhooks`.
# Local: `stripe listen --forward-to localhost:3000/api/stripe/webhooks`
STRIPE_WEBHOOKS_ENDPOINT_SECRET=
# Public origin used to build Checkout success/cancel URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
