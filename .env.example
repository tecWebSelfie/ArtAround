# Added by Payload
PAYLOAD_SECRET=
# With the compose Mongo (credentials from .env.mongo):
# mongodb://USER:PASSWORD@mongodb:27017/artaround?authSource=admin
DATABASE_URL=

NEXT_PUBLIC_PAYLOAD_URL=
PAYLOAD_MCP_KEY=

#API MOCKING
NEXT_PUBLIC_API_MOCKING=

#LiveKit (group tours, docs/group-tours.md). Local: ws://localhost:7880 with devkey/secret
# from my-agent/compose.livekit.yaml; production: a LiveKit Cloud wss:// URL and keys.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

#Mint (3D models generation and hosting)
MINT_API_KEY=

#Stripe (SANDBOX ONLY — use test keys `sk_test_…`)
# Secret API key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret for `POST /api/stripe/webhooks`.
# Local: `stripe listen --forward-to localhost:3000/api/stripe/webhooks`
STRIPE_WEBHOOKS_ENDPOINT_SECRET=
# Public origin used to build Checkout success/cancel URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
