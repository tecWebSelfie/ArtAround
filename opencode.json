{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/tecweb/artaround",
      "oauth": {}
    },
    "livekit-docs-mcp": {
      "type": "remote",
      "url": "https://docs.livekit.io/mcp"
    },
    "mantine-ui": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mantine/mcp-server"
      ]
    },
    "nextjs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  }
}
