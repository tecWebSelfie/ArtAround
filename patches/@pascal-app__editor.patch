+    const plain = buildFirstPersonColliderWorldFromRegistry()!
+    const world = buildFirstPersonColliderWorldFromRegistry({ includeNavSceneRegistry: true })!
+    expect(Object.keys(world.navSceneRegistry!).sort()).toEqual([
+      'fallback-level:level_nav_a', 'fallback-level:level_nav_b',
+    ])
+    expect(world.navSceneRegistry!['fallback-level:level_nav_a']!.node).toBe(levelA)
+    expect(world.navSceneRegistry!['fallback-level:level_nav_b']!.node).toBe(levelB)
+    expect(Array.from(world.mesh.geometry.getAttribute('position').array)).toEqual(
+      Array.from(plain.mesh.geometry.getAttribute('position').array),
+    )
+    plain.dispose()
+    world.dispose()
+  })
