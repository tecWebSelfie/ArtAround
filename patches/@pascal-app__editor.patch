+      Array.from(plain.mesh.geometry.getAttribute('position').array),
+    )
+    const entry = world.navSceneRegistry![column.id]!
+    expect(entry.node).toBe(column)
+    expect(entry.object.geometry.getAttribute('position').count).toBe(72)
+    expect(entry.object.parent).toBeNull()
+    expect(entry.object.position.toArray()).toEqual([0, 0, 0])
+    expect(entry.object.scale.toArray()).toEqual([1, 1, 1])
+    entry.object.geometry.computeBoundingBox()
+    expect(entry.object.geometry.boundingBox?.min.x).toBeCloseTo(9.5)
+    expect(entry.object.geometry.boundingBox?.max.x).toBeCloseTo(14.5)
+    plain.dispose()
+    world.dispose()
+  })
