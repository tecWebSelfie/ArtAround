+    const levelB = LevelNode.parse({ id: 'level_nav_b', parentId: buildingB.id, level: 0 })
+    const siteA = SiteNode.parse({ id: 'site_nav_a' })
+    const siteB = SiteNode.parse({ id: 'site_nav_b' })
