+/** Validate an adopted node with its own kind, preserving custom plugin fields. */
+function parseMovedNode(candidate: ItemNode): AnyNode {
+  // Keep the existing item path, including callers that have not loaded plugins.
+  if (candidate.type === 'item') return ItemNode.parse(candidate)
+
+  const definition = nodeRegistry.get(candidate.type)
+  if (!definition) {
+    throw new Error(`Cannot move unregistered node kind "${candidate.type}"`)
+  }
+  // The registry also contains plugin kinds outside core's built-in AnyNode union.
+  const parsed = definition.schema.parse(candidate) as AnyNode
+  if (parsed.id !== candidate.id || parsed.type !== candidate.type) {
+    throw new Error('Moving a node must preserve its id and type')
+  }
+  return parsed
+}
